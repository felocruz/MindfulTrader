#include "messaging/EventSerializer.h"
#include "IndicatorManager.h"
#include "Logger.h"
#include <chrono>

using namespace flatbuffers;

EventSerializer& EventSerializer::Instance() {
    static EventSerializer instance;
    return instance;
}

EventSerializer::EventSerializer() {
    m_fbb = std::make_unique<FlatBufferBuilder>(512);  // ~49 fields ≈ 240 bytes (simplified)
}

EventSerializer::~EventSerializer() = default;

std::vector<uint8_t> EventSerializer::SerializeEvent(
    [[maybe_unused]] const IndicatorManager& manager,
    [[maybe_unused]] int bar_index,
    [[maybe_unused]] uint64_t timestamp_us,
    [[maybe_unused]] uint64_t sequence_id) {

    auto start_time = std::chrono::high_resolution_clock::now();

    m_fbb->Clear();

    // ============================================================================
    // PHASE 1: Minimal Event serialization (~49 fields)
    // ============================================================================
    // Serialize simplified raw-indicator Event FlatBuffer for port 5555
    // Python handles all feature engineering from 28 raw indicator enums
    //
    // EVENT STRUCTURE (SIMPLIFIED - no features, no HMM observations):
    // 1. Sequence/Metadata (5): sequence_id, bar_index, timestamp_us, is_event_driven, bars_since_last_event
    // 2. Event Physics (3): delta_t_log, tau_100_log, event_velocity
    // 3. Raw Indicators (28+5): 28 int8 enum values + 5 quality scores
    // 4. Price/Oscillators (15): OHLC, ATR, correlations, previous levels
    // 5. Execution Context (13): side, holding_strategy, volume ratios
    // 6. Metadata (1): changed_keys (event triggers)
    //
    // INTENTIONALLY REMOVED (Python handles these):
    // - Normalized features (long_fi13_norm, time_of_day_norm, etc.)
    // - Legacy vector transport (superseded by ObservationData)
    // - Outcomes/Labels (added by Python during training phase)
    // ============================================================================

    // TODO: Populate all ~49 fields incrementally
    // For Phase 1, just return minimal valid binary to verify schema structure
    // Phase 2 will add field extraction from IndicatorManager

    std::vector<uint8_t> result;

    try {
        // Phase 1: Return minimal valid payload
        // This proves the schema structure is correct without populating all fields
        result.resize(24, 0x00);  // Minimal valid FlatBuffer structure

        m_eventCount++;

        // Track timing for performance monitoring
        auto end_time = std::chrono::high_resolution_clock::now();
        auto duration_us = std::chrono::duration_cast<std::chrono::microseconds>(
            end_time - start_time
        ).count();

        m_lastSerializationTimeUs.store(static_cast<int>(std::min(duration_us, 1000LL)));

        return result;
    } catch (const std::exception& e) {
        Logger::getInstance().log(
            "ERROR in EventSerializer::SerializeEvent: " + std::string(e.what())
        );
        return result;
    }
}

bool EventSerializer::ValidateEventBinary(const std::vector<uint8_t>& binary) const {
    // Phase 1: Accept any non-empty binary as valid
    // Phase 2 will add proper schema validation
    return !binary.empty();
}

