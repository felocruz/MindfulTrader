# --------------------------------
# 1. CMake Build Artifacts (Crucial!)
# --------------------------------
# The main build directory generated by CMake
/build/
# clang-cl cross-compile output (build_dll.sh) — 112 MB incl. the 1 GB DLL
/build-windows/
# CMake files (typically in-source, but better to be safe)
CMakeCache.txt
CMakeFiles/
# Output binaries and libraries
*.o
*.a
*.so
*.dylib
*.dll
*.exe
# CTest/Testing files
Testing/
_CPack_Packages/

# --------------------------------
# 1b. Generated Schema / Backups / Runtime Data
# --------------------------------
# Timestamped backups left by schema regeneration (regenerable)
include/generated/*.bak_*
include/generated/*.bak
# Python bytecode caches
__pycache__/
*.py[cod]
# Backtest + Sierra Chart binary artifacts (regenerable from replay)
*.btst
*.lbr

# --------------------------------
# 2. VS Code Files
# --------------------------------
# Workspace settings (can contain local paths/secrets)
.vscode/settings.json
# Task runner history
.vscode/tasks.json
# Launch configurations (often specific to local environment)
.vscode/launch.json
# Local debugger artifacts
.vscode/*.log
.vscode/out/

# --------------------------------
# 3. Compiler/Editor Artifacts (General C/C++)
# --------------------------------
# Generated by various editors/IDEs
*~
# Vim/Nano backup files
*.swp
# Dependency files
.dep

# --------------------------------
# 4. Gemini CLI Specifics
# --------------------------------
# If Gemini CLI or any other tool generates a cache directory
# (often named .gemini-cli-cache, .aidev-cache, etc.)
.gemini-cli-cache/
.aidev-cache/
.llm-cache/

# --------------------------------
# 5. Linux/WSL Specific Files
# --------------------------------
# Standard Linux/Unix temp files
*.tmp
# Log files
*.log
# Package manager artifacts (if generated in project root)
/pkg/
# History files
.bash_history
.zsh_history

# --------------------------------
# 6. Windows/Cross-Platform Compatibility
# --------------------------------
# Thumbs.db (Windows image cache)
Thumbs.db
# desktop.ini (Windows folder customization)
desktop.ini
