#pragma once

#include <vector>
#include <cstdint>
#include <atomic>
#include <memory>
#include "flatbuffers/flatbuffers.h"
#include "generated/mts_schema_generated.h"

// Forward declarations
class IndicatorManager;

/**
 * EventSerializer: Elite v2.4 Event Message Serialization
 *
 * Purpose:
 * - Serialize IndicatorManager state to FlatBuffer Event (~49 fields, raw indicators)
 * - Event contains only trading signal inputs (raw indicator enums + price data)
 * - Python handles all feature engineering (normalized fields, distances, etc.)
 * - Uses canonical ObservationData flow (no legacy vector transport)
 *
 * Design Principle:
 * - C++ sends raw indicators, Python computes features
 * - Event = observation-only subset of TrainingEvent
 * - Keeps payload lightweight (~240 bytes) for real-time streaming
 *
 * Event Fields (~49 total):
 * - Sequence (5): sequence_id, bar_index, timestamp_us, is_event_driven, bars_since_last_event
 * - Physics (3): delta_t_log, tau_100_log, event_velocity
 * - Indicators (28+5): Raw int8 enum values + 5 quality scores
 * - Price/Context (15): OHLC, ATR, correlations, previous levels
 * - Execution (13): side, holding_strategy, volume ratios
 * - Metadata (1): changed_keys (event triggers)
 *
 * REMOVED (Python handles these):
 * - Normalized features (long_fi13_norm, time_of_day_norm, etc.)
 * - Legacy vector transport (superseded by ObservationData)
 * - Outcomes/Labels (added by Python during training phase)
 *
 * Event Table Design (84 fields):
 * - Section 1: Sequence/Metadata (sequence_id, timestamp_us, bar_index)
 * - Section 2: Indicators (31 enums: RSI, MACD, Stochastic, etc.)
 * - Section 3: Price (close, bar_range, SAR distance, PDH/PDL)
 * - Section 4: Context (time_of_day, session_age, intrabar_confidence)
 * - Section 5: HMM State (regime_entropy, regime_probabilities)
 * - Section 6: Features/Normalized (feature_vector [29], normalized_anchors [5])
 * - Section 7: Metadata (event_type_code, event_severity)
 * - NO Section 8: Outcomes (reserved for training labels only)
 *
 * Architecture:
 * - Singleton pattern (one per process)
 * - Reusable FlatBufferBuilder (efficiency)
 * - Called from IndicatorManager::SendEventFlatBuffer()
 * - Output: MTS_Envelope containing Event (for ZMQ port 5555)
 *
 * Data Flow:
 * - IndicatorManager calls EventSerializer::Instance().SerializeEvent(...)
 * - EventSerializer populates 84 Event fields from indicator state
 * - Wraps in MTS_Envelope with EventHeader (sequence_id, timestamp_us, validity)
 * - Returns binary FlatBuffer ready for ZMQ transport
 * - Python EventConsumer deserializes and validates sequence continuity
 *
 * Performance:
 * - Serialization: 10-20µs per event (all 84 fields)
 * - Message size: 240-320 bytes (compressed FlatBuffer)
 * - Zero allocations (reused builder)
 *
 * CRITICAL DISTINCTION:
 * - EventSerializer → Event (trading signals from IndicatorManager)
 * - ObservationData/AsymmetryContext are carried through canonical live/training schema tables
 * - Keep transport contract aligned with `mts_schema.fbs` generated bindings
 */
class EventSerializer {
public:
    static EventSerializer& Instance();

    /**
     * SerializeEvent: Create 84-field Event from IndicatorManager state
     *
     * Params:
     *   manager: IndicatorManager with current indicator state
     *   bar_index: Current bar number from Sierra Chart
     *   timestamp_us: Microsecond precision timestamp
     *   sequence_id: Global counter (must be unique and sequential)
     *
     * Returns:
     *   Binary MTS_Envelope containing Event table
     *   Ready for ZMQ PUB on port 5555
     */
    std::vector<uint8_t> SerializeEvent(
        const IndicatorManager& manager,
        int bar_index,
        uint64_t timestamp_us,
        uint64_t sequence_id
    );

    // Statistics for monitoring
    int GetLastSerializationTimeUs() const { return m_lastSerializationTimeUs.load(); }
    uint64_t GetEventCount() const { return m_eventCount.load(); }

    // Validation
    bool ValidateEventBinary(const std::vector<uint8_t>& binary) const;

private:
    EventSerializer();
    ~EventSerializer();

    // Prevent copying
    EventSerializer(const EventSerializer&) = delete;
    EventSerializer& operator=(const EventSerializer&) = delete;

    // Persistent FlatBufferBuilder (reused for efficiency)
    std::unique_ptr<flatbuffers::FlatBufferBuilder> m_fbb;

    // Statistics (lock-free)
    std::atomic<uint64_t> m_eventCount{0};
    std::atomic<int> m_lastSerializationTimeUs{0};
};
